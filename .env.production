# Production configuration for Small Circles. Placeholders only: never put a
# real key in this file, it is committed. The backslash keeps each ${...}
# literal so Next.js does not try to expand it at build time.
#
# The browser only needs the Convex URL, and `npm run deploy` fills it in from
# the production deployment when it builds.
NEXT_PUBLIC_CONVEX_URL=\${NEXT_PUBLIC_CONVEX_URL}

# Everything below is read by the Convex backend, not by Next.js. Set each one
# on the deployment: `npx convex env set --prod OPENAI_API_KEY <key>`.
OPENAI_API_KEY=\${OPENAI_API_KEY}
OPENAI_MODEL=\${OPENAI_MODEL}
FIRECRAWL_API_KEY=\${FIRECRAWL_API_KEY}
AGENTMAIL_API_KEY=\${AGENTMAIL_API_KEY}
AGENTMAIL_WEBHOOK_SECRET=\${AGENTMAIL_WEBHOOK_SECRET}
MOMENTS_INBOX_ADDRESS=\${MOMENTS_INBOX_ADDRESS}
SITE_URL=\${SITE_URL}
