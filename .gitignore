# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# secrets: keys for Convex, OpenAI, Firecrawl and AgentMail live here
.env*
!.env.example

# convex local state (the deployment's own; `convex/_generated` IS committed,
# so the app typechecks and builds from a clean clone)
/.convex

# editor and agent tooling
/.claude
.vscode
.idea
.DS_Store
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# working notes that are ours, not the app. README.md, ABOUT.md and
# hackathon.md (the build log judges read) are what this repo publishes.
/docs
/scripts
canvas.md
SMALLCIRCLES-BUILD-PROMPT.md

# hosting
.vercel
